// The shader of rillfacet's solid (3D) and UV (2D) texture slots: one row
// per (instance, slot), its family saying which kind it draws (a UV row's
// family is stored plus UT_FAMILY_OFFSET; rillfacet.uv_texture.render_rows).

#include "stdosl.h"
#include "solid_texture.h"
#include "uv_texture.h"

// The material's base color, roughness and (Bump) shading normal from the
// row in p0..p7 / w0..w7 (parameters 4k..4k+2 / 4k+3: the object
// attributes rf_s<slot>_<k>; colors linear) at the body-local point Pl
// (the Object texture coordinate; solid rows) or the metric UV Uv (the
// rf_muv UV map; UV rows). The bump: finite differences of h (as
// rillfacet's backends: N - grad h * bump); for a solid row along two
// tangents of N, taken body-local, for a UV row along u and v, times the
// face's body-local surface gradients of u and v (Gu, Gv: the rf_gu /
// rf_gv face attributes).
shader rf_texture(
    point Pl = point(0),
    vector Uv = vector(0),
    vector Gu = vector(0),
    vector Gv = vector(0),
    vector p0 = 0, vector p1 = 0, vector p2 = 0, vector p3 = 0,
    vector p4 = 0, vector p5 = 0, vector p6 = 0, vector p7 = 0,
    float w0 = 0, float w1 = 0, float w2 = 0, float w3 = 0,
    float w4 = 0, float w5 = 0, float w6 = 0, float w7 = 0,
    int Bump = 0,
    output color Color = 0,
    output float Roughness = 0,
    output float Height = 0,
    output normal Normal = 0)
{
  vector pv[8] = {p0, p1, p2, p3, p4, p5, p6, p7};
  float wv[8] = {w0, w1, w2, w3, w4, w5, w6, w7};
  float S[32];
  for (int k = 0; k < 8; k++) {
    S[4 * k] = pv[k][0];
    S[4 * k + 1] = pv[k][1];
    S[4 * k + 2] = pv[k][2];
    S[4 * k + 3] = wv[k];
  }
  int is_uv = S[ST_FAMILY] >= UT_FAMILY_OFFSET - 0.5;
  float h0;
  if (is_uv) uv_texture(S, Uv[0], Uv[1], h0, Color);
  else solid_texture(S, Pl, h0, Color);
  Height = h0;
  Roughness = nz_lerp(S[ST_ROUGH0], S[ST_ROUGH1], h0);
  Normal = N;
  if (Bump) {
    float eps = S[ST_EPS] / S[ST_SCALE];
    float h1, h2;
    color c;
    vector g;
    if (is_uv) {
      uv_texture(S, Uv[0] + eps, Uv[1], h1, c);
      uv_texture(S, Uv[0], Uv[1] + eps, h2, c);
      g = transform("object", "world", Gu * (h1 - h0) + Gv * (h2 - h0));
    } else {
      vector a = abs(N[0]) > 0.9 ? vector(0, 1, 0) : vector(1, 0, 0);
      vector t1 = normalize(cross(N, a));
      vector t2 = cross(N, t1);
      solid_texture(S, Pl + eps * transform("world", "object", t1), h1, c);
      solid_texture(S, Pl + eps * transform("world", "object", t2), h2, c);
      g = t1 * (h1 - h0) + t2 * (h2 - h0);
    }
    Normal = normalize(N - g * (S[ST_BUMP] / eps));
  }
}
